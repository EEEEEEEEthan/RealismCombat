[sub_resource type="GDScript" id="GDScript_bm06t"]
script/source = "extends Node
class_name Program

@onready var generic_dialogue: GenericDialogue = %GenericDialogue
var combat: Combat

func show_menu(
	title: String,
	options: Array[MenuItemData],
) -> void:
	var dialogue:MenuDialogue = %MenuDialogue.create_instance()
	dialogue.title = title
	dialogue.options = options

func create_combat() -> Combat:
	if not combat:
		var c:Combat = %Combat.create_instance()
		combat = c
	else:
		push_error(&\"combat already exists\")
	return combat

func _ready() -> void:
	var menu:MenuDialogue = Dialogues.create_menu()
	menu.title = \"Realism Combat\"
	menu.options = [
		MenuItemData.new(\"新游戏\", false, \"开启一段新的故事\"),
		MenuItemData.new(),
		MenuItemData.new(),
		MenuItemData.new(),
		MenuItemData.new(),
		MenuItemData.new(\"退出\", false, \"离开\"),
	]
	var index = await menu.pressed
	if index == 0:
		menu.queue_free()
		%Game.create_instance()
"

