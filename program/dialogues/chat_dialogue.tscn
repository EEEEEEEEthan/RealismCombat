script/source = "extends VBoxContainer

func await_message(msg: String) -> void:
	# 将msg追加到 %Message, 自动打字机播放
	# 按住任意键可以加速播放
	# 异步函数,在播放结束时结束
	pass

func await_continue() -> void:
	# 显示 %ContinueArrow
	# 等待玩家按确认,或者鼠标点击任意位置
	# 隐藏 %ContinueArrow
	pass

func await_choice(choices: Array[String]) -> int:
	# %Options添加对应按钮
	# 等待玩家点对应按钮
	# 返回按钮下标
	# 删除这些按钮
	return 0
"

