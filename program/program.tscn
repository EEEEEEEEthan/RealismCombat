[sub_resource type="GDScript" id="GDScript_6efdo"]
script/source = "extends VBoxContainer

func _ready() -> void:
	%ScrollContainer.get_v_scroll_bar().value_changed.connect(_update_arrows)
	item_rect_changed.connect(_update_arrows)
	_update_arrows()

func _update_arrows(_unused: float = 0.0) -> void:
	var content_h := size.y
	var view_h: float = %ScrollContainer.size.y
	if content_h <= view_h:
		%UpArrow.self_modulate.a = 0.0
		%DownArrow.self_modulate.a = 0.0
		return
	%UpArrow.self_modulate.a = 1.0 if %ScrollContainer.scroll_vertical > 0 else 0.0
	%DownArrow.self_modulate.a = 1.0 if %ScrollContainer.scroll_vertical < content_h - view_h else 0.0
"

