[gd_scene format=3 uid="uid://6mmoxrtvmr2r"]

[sub_resource type="GDScript" id="GDScript_5sy16"]
script/source = "extends Node

func _ready() -> void:
	while true:
		var main_menu = %MainMenuPlaceHolder.create_instance()
		var line = await main_menu.submitted
		var command = line[0]
		var args = line[1]
		if command == \"new_game\":
			main_menu.queue_free()
			var game = %GamePlaceHolder.create_instance()
			await game.tree_exited
		if command == \"load_game\":
			main_menu.queue_free()
			var game = %GamePlaceHolder.create_instance()
			await game.tree_exited
"

[node name="Program" type="Node" unique_id=248735067]
script = SubResource("GDScript_5sy16")

