[gd_scene format=3 uid="uid://lb3ta0rakcoq"]

[ext_resource type="Texture2D" uid="uid://dkajou5ypu7d0" path="res://program/theme_atlas.png" id="1_agoep"]
[ext_resource type="Script" uid="uid://c7x2ufjmo3scc" path="res://program/game_button.gd" id="2_ii8tc"]

[sub_resource type="GDScript" id="GDScript_ii8tc"]
script/source = "@tool
extends PanelContainer

@export var enabled: bool:
	set(value):
		enabled = value
		if not is_node_ready():
			await ready
		%LoadGame.disabled = !value
		%NewGame.disabled = !value
		%Quit.disabled = !value
		var colorpalette = ResourceLoader.load(\"uid://crnuuc7im2w62\") as ColorPalette
		if value:
			grab_focus()
			self_modulate = colorpalette.colors[55]
		else:
			release_focus()
			%Menu.self_modulate = colorpalette.colors[3]

func _ready() -> void:
	%LoadGame.toggled.connect(_on_load_game_toggled)

func _on_load_game_toggled(is_on: bool) -> void:
	%Slots.visible = is_on

func _on_new_game_toggled(is_on: bool) -> void:
	%Slots.visible = is_on
"

[sub_resource type="AtlasTexture" id="AtlasTexture_p1j5j"]
