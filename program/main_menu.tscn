[sub_resource type="GDScript" id="GDScript_agoep"]
script/source = "extends PanelContainer

func _ready() -> void:
	visible = false
	_update_visible()

func _update_visible() -> void:
	visible = %LoadGame.button_pressed or %NewGame.button_pressed

func _on_visibility_changed() -> void:
	%Menu.enabled = !visible

func _unhandled_input(event: InputEvent) -> void:
	#按esc或者鼠标在任何地方点右键都visible = false
	pass
"

