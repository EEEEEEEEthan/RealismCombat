; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="超写实战斗"
run/main_scene="uid://d0s0aws01q13e"
config/features=PackedStringArray("4.6", "Forward Plus")

[display]

window/size/viewport_width=256
window/size/viewport_height=224
window/size/initial_position_type=4
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="RealismCombat"

[editor]

external_editor/exec_path="C:/Program Files/JetBrains/JetBrains Rider 2025.1.4/bin/rider64.exe"
external_editor/exec_flags="{project}"
"--line{line}{file}[editor_plugins]enabled"=PackedStringArray()

[editor_plugins]

enabled=PackedStringArray("res://addons/editable_texture/plugin.cfg")

[gui]

theme/custom="uid://nedlt21e76s8"
theme/custom_font="uid://coprcrk20pwv2"

[autoload]

FocusDebugger="*res://FocusDebugger.gd"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
