[gd_scene format=3 uid="uid://darn4wy8o3l5q"]

[sub_resource type="GDScript" id="GDScript_test_menu"]
script/source = "extends Control

const MENU_DIALOGUE_SCENE: PackedScene = preload(\"res://dialogues/menu_dialogue.tscn\")


func _ready() -> void:
	var menu_data: Array[MenuItemData] = []
	for option_index in range(16):
		var entry := MenuItemData.new()
		entry.text = \"测试项%d\" % (option_index + 1)
		entry.description = \"第 %d 项说明。\" % (option_index + 1)
		entry.disabled = option_index == 6
		menu_data.append(entry)
	var menu_root: Node = MENU_DIALOGUE_SCENE.instantiate()
	add_child(menu_root)
	menu_root.options = menu_data
	menu_root.pressed.connect(_on_menu_dialogue_pressed)


func _on_menu_dialogue_pressed(option_index: int) -> void:
	print(\"MenuDialogue 选中: \", option_index)
"

[node name="TestMenuDialogue" type="Control" unique_id=1286952369]
