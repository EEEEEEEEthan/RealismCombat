[sub_resource type="GDScript" id="GDScript_idsq7"]
script/source = "extends TextureRect

var _action_points: Property

func bind(action_points: Property) -> void:
	_action_points = action_points
	action_points.changed.connect(_on_value_changed)

func _on_value_changed() -> void:
	self_modulate = Color(1, 1, 1, _action_points.value / _action_points.max_value)
"

[sub_resource type="GDScript" id="GDScript_cybvm"]
script/source = "@tool
extends Control

var _preferred_height: float
@export var expanded: bool:
	set(v):
		expanded = v
		_preferred_height = $VBoxContainer.size.y if v else 0

func _ready() -> void:
	set_process(true)

func _process(delta: float) -> void:
	var height = custom_minimum_size.y
	height = lerpf(height, _preferred_height, clampf(12 * delta, 0.0, 1.0))
	var new_min := Vector2(custom_minimum_size.x, height)
	custom_minimum_size = new_min
"

