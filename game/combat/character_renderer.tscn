[sub_resource type="GDScript" id="GDScript_1ydc4"]
script/source = "@tool
extends Node
const JITTER_INTERVAL := 0.05
@export var jitter_range: float = 0.0

func _process(_delta: float) -> void:
	owner.get_node(\"%Mirror\").position = Vector2(
		randf_range(-jitter_range, jitter_range),
		randf_range(-jitter_range, jitter_range),
	)
"

