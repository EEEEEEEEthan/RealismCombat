[sub_resource type="Shader" id="Shader_idsq7"]
code = "shader_type canvas_item;

uniform vec4 color_fill : source_color = vec4(0.35, 0.78, 0.38, 1.0);
uniform vec4 color_bg : source_color = vec4(0.14, 0.14, 0.16, 1.0);
uniform float repick_seconds : hint_range(0.05, 2.0) = 0.3;

varying float local_vertex_x;
varying vec4 modulate;

void vertex() {
	local_vertex_x = VERTEX.x;
	modulate = COLOR;
}

float hash_column(float key_x) {
	float x = fract(key_x * 0.1031);
	x *= x + 33.33;
	return fract(x * x);
}

void fragment() {
	float progress = modulate.a;
	float use_full = step(1.0, progress);
	float u = mix(UV.x, 1.0 - UV.x, step(0.5, modulate.r));
	vec4 bar = mix(color_bg, color_fill, float(u < progress)) * texture(TEXTURE, UV);
	float column_x = floor(local_vertex_x);
	float time_slice = floor(TIME / repick_seconds);
	float random_unit = hash_column(column_x + time_slice * 419.431);
	float direction = step(0.85, random_unit) - (1.0 - step(0.15, random_unit));
	vec2 sample_uv = UV + vec2(0.0, direction * TEXTURE_PIXEL_SIZE.y);
	vec4 full = color_fill * texture(TEXTURE, sample_uv);
	COLOR = mix(bar, full, use_full);
}
"

