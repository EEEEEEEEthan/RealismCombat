[sub_resource type="GDScript" id="GDScript_tpvsg"]
resource_name = "IdleState"
script/source = "extends Node

@onready var parent_machine: CharacterStateMachine = get_parent()

func new_tick() -> void:
	var action_points:= parent_machine.action_points
	action_points.value = minf(
		action_points.value + parent_machine.action_points_per_tick,
		action_points.max_value,
	)
	if action_points.value >= action_points.max_value:
		AudioManager.play_turn_begin()
		if parent_machine.is_player:
			var dialogue := Dialogues.create_generic_dialogue()
			dialogue.text = parent_machine.character.character_name + \"的回合!\"
			await dialogue.pressed
			dialogue.queue_free()
			await player_turn_choose_from_body_part()
		else:
			await ai()

func player_turn_choose_from_body_part() -> void:
	var menu = Dialogues.create_menu_dialogue()
	var options:Array[MenuItemData] = [
		MenuItemData.new(&\"头部\", false, &\"头部状态\"),
		MenuItemData.new(&\"胸部\", false, &\"胸部状态\"),
		MenuItemData.new(&\"右手\", false, &\"右手状态\"),
		MenuItemData.new(&\"左手\", false, &\"左手状态\"),
		MenuItemData.new(&\"右腿\", false, &\"右腿状态\"),
		MenuItemData.new(&\"左腿\", false, &\"左腿状态\"),
	]
	menu.title = parent_machine.character.character_name + &\"的回合\"
	menu.options = options
	while true:
		var choice = await menu.pressed
		var from_body := parent_machine.character.all_body_parts[choice]
		if await player_turn_choose_action(from_body):
			break
	menu.queue_free()

func player_turn_choose_action(from_body: BodyPart) -> bool:
	var menu = Dialogues.create_menu_dialogue()
	menu.title = parent_machine.character.character_name + &\"的回合>\" + from_body.part_name
	var options: Array[MenuItemData]
	var action_list: Array[Action]
	for action in parent_machine.character.actions:
		if not action.static_valid_from_body(from_body).success: continue
		var outcome = action.static_valid_to_body(from_body)
		var data = MenuItemData.new(action.action_name)
		if not outcome.success:
			data.disabled = true
			data.description = outcome.error_message
		else:
			data.disabled = false
			data.description = action.description
		options.append(data)
		action_list.append(action)
	options.append(MenuItemData.new(&\"返回\", false, &\"返回上一级\"))
	menu.options = options
	while true:
		var choice = await menu.pressed
		if choice >= len(action_list): break
		var action = action_list[choice]
		if await player_turn_choose_target(action, from_body):
			menu.queue_free()
			return true
	menu.queue_free()
	return false

func player_turn_choose_target(action: Action, from_body: BodyPart) -> bool:
	var menu = Dialogues.create_menu_dialogue()
	menu.title = parent_machine.character.character_name + &\"的回合>\" + from_body.part_name + &\">\" + action.action_name
	var options: Array[MenuItemData]
	var characters: Array[Character]
	for chr in parent_machine.combat.characters:
		if not action.static_valid_to_character(chr).success:
			continue
		var data = MenuItemData.new(chr.character_name)
		var outcome = action.dynamic_valid_to_character(chr)
		if outcome.success:
			data.description = &\"选择\" + chr.character_name + &\"为目标\"
		options.append(data)
		characters.append(chr)
	options.append(MenuItemData.new(&\"返回\", false, &\"返回上一级\"))
	menu.options = options
	while true:
		var choice = await menu.pressed
		if choice >= len(characters): break
		var chr = characters[choice]
		if await player_turn_choose_target_body(action, from_body, chr):
			menu.queue_free()
			return true
	menu.queue_free()
	return false

func player_turn_choose_target_body(action: Action, from_body: BodyPart, to_character: Character) -> bool:
	var menu = Dialogues.create_menu_dialogue()
	menu.title = parent_machine.character.character_name + &\"的回合>\" + from_body.part_name + &\">\" + action.action_name + &\">\" + to_character.character_name
	var options: Array[MenuItemData]
	var body_list: Array[BodyPart]
	for to_body in to_character.all_body_parts:
		if not action.static_valid_to_body(to_body).success:
			continue
		var data = MenuItemData.new(str(to_body.part_name))
		var dynamic_outcome = action.dynamic_valid_to_body(to_body)
		if dynamic_outcome.success:
			data.disabled = false
			data.description = &\"选择\" + str(to_body.part_name) + &\"为目标\"
		else:
			data.disabled = true
			data.description = dynamic_outcome.error_message
		options.append(data)
		body_list.append(to_body)
	options.append(MenuItemData.new(&\"返回\", false, &\"返回上一级\"))
	menu.options = options
	while true:
		var choice = await menu.pressed
		if choice >= len(body_list): break
		menu.queue_free()
		await parent_machine._set_action(action, from_body, body_list[choice])
		return true
	menu.queue_free()
	return false

func ai() -> void:
	var actions: Array[ActionParameter]
	var from = parent_machine.character
	for action:Action in from.actions:
		for from_body:BodyPart in from.all_body_parts:
			if not action.valid_from_body(from_body): continue
			for to_character:Character in parent_machine.combat.characters:
				if not action.valid_to_character(to_character): continue
				for to_body:BodyPart in to_character.all_body_parts:
					if not action.valid_to_body(to_body): continue
					var weight = action.get_weight(from_body, to_body)
					var parameter = ActionParameter.new()
					parameter.action = action
					parameter.from = from_body
					parameter.to = to_body
					parameter.weight = weight
					actions.append(parameter)
	# 从actions里抽选一个
	if actions.is_empty():
		return
	var total_weight := 0.0
	for p in actions:
		total_weight += p.weight
	var chosen: ActionParameter = actions[0]
	if total_weight > 0.0:
		var roll := randf() * total_weight
		var acc := 0.0
		for p in actions:
			acc += p.weight
			if roll < acc:
				chosen = p
				break
	await parent_machine._set_action(chosen.action, chosen.from, chosen.to)

class ActionParameter:
	var action: Action
	var from: BodyPart
	var to: BodyPart
	var weight: float
"

[sub_resource type="GDScript" id="GDScript_4kuc4"]
resource_name = "ActionState"
script/source = "extends Node

@onready var parent_machine: CharacterStateMachine = get_parent()
var _windup: float
var _action: Action
var _from_body: BodyPart
var _to_body: BodyPart

func set_action(action:Action, from_body:BodyPart, to_body:BodyPart) -> void:
	_action = action
	_from_body = from_body
	_to_body = to_body
	_windup = action.windup_action_points
	await action.prepare(from_body, to_body)

func new_tick() -> void:
	_windup -= parent_machine.action_points_per_tick
	if _windup <= 0:
		await _action.execute(_from_body, _to_body)
		parent_machine._set_idle(_action.recovery_action_points)
		_action = null
		_from_body = null
		_to_body = null
"

